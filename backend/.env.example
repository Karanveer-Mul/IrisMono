PORT=3000
# Three connection identities - see src/db/index.ts and migration 0002.
# Runtime identity: Row-Level Security enforced. Must NOT be a superuser,
# because superusers bypass RLS unconditionally.
DATABASE_URL=postgresql://irismono_app:irismono_app_password@localhost:5432/irismono
# Pre-tenant and system operations (login, registration, invite redemption,
# worker job reports). Has BYPASSRLS.
AUTH_DATABASE_URL=postgresql://irismono_auth:irismono_auth_password@localhost:5432/irismono
# DDL and migrations only.
ADMIN_DATABASE_URL=postgresql://postgres:password@localhost:5432/irismono
JWT_SECRET=super-secret-medical-saas-key-change-in-production

# Master key wrapping each organization's data key, base64, exactly 32 bytes.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Deliberately NOT defaulted: a hardcoded fallback would let a deployment that
# forgot to set it encrypt everything with a key published in the source tree,
# which looks encrypted and is worse than honest plaintext. Unset, scans are
# stored in the clear and the API says so. In deployment this belongs in a KMS -
# see src/crypto.ts, which is explicit about the difference.
MASTER_KEY_BASE64=

# Sign-in throttling.
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12

# Applied when an admin creates an invite without specifying them. The safe
# value has to be the one you get by not thinking about it: a link that never
# expires and never runs out is the shape of every invite-link incident.
DEFAULT_INVITE_MAX_USES=25
DEFAULT_INVITE_DAYS=30
AMQP_URL=amqp://guest:guest@localhost:5672

# Shared secret the GPU worker presents when reporting job outcomes to the API.
WORKER_SECRET=local-dev-worker-secret
# Shared secret the object store presents when notifying an upload. Separate
# from the worker's: the two are different trust domains with different blast
# radii - the notifier can start work, the worker can settle it - so rotating
# one must not require rotating the other.
STORAGE_EVENT_SECRET=local-dev-storage-secret
# Ceiling on a single uploaded scan. A presigned PUT lets the client choose the
# body, so this is enforced as the bytes stream in, not from Content-Length.
MAX_UPLOAD_BYTES=26214400
# Where the worker reaches the API to report outcomes.
API_BASE_URL=http://localhost:3000
# Which tier queues this worker serves (comma separated). Start a second worker
# with WORKER_QUEUES=queue-vip-jobs to give enterprise tenants dedicated GPUs.
WORKER_QUEUES=queue-standard-jobs
# Stamped onto every job this worker completes. In a real deployment this is the
# image tag or model artifact digest, injected at deploy time - a mask whose
# model version is unknown cannot be recalled if that model is withdrawn.
MODEL_VERSION=irismono-seg-sim-0.1.0
# Defaults to hostname:pid if unset.
# WORKER_ID=
# In-process report retries before a message is dead-lettered.
WORKER_REPORT_ATTEMPTS=3
WORKER_REPORT_RETRY_DELAY_MS=2000

# Redelivery schedule for a job whose outcome could not be established, as
# comma-separated delays. One holding queue is declared per entry, so changing
# this adds or removes queues rather than altering existing ones. Growing
# delays on purpose: retrying hard against a dependency that is down is how a
# brief outage becomes a long one. Exhausting the list dead-letters the message.
JOB_RETRY_DELAYS_MS=10000,60000,300000

# Reaper: reclaims credits from jobs that will never finish.
JOB_PENDING_TIMEOUT_MINUTES=30
JOB_PROCESSING_TIMEOUT_MINUTES=15
REAPER_INTERVAL_SECONDS=60

# Storage retention. Deletes stored images after this many days; job metadata is
# kept indefinitely for billing and audit. Set to 0 to disable.
# This is the platform default only: a tenant with organizations.retention_days
# set uses their own window, which is what a hospital contract negotiates.
# On real S3, configure a lifecycle rule per org_id= prefix - see src/retention.ts.
STORAGE_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_HOURS=6

# How many jobs a tenant may hold PENDING/PROCESSING at once, platform-wide.
# arch.md section 1: "restrict users via configuration to uploading exactly 1
# image at a time" - configuration, not a constant, so a tenant with
# organizations.max_concurrent_jobs set uses their own limit instead. See
# src/routes/jobs.ts.
MAX_CONCURRENT_JOBS_DEFAULT=1
# Jobs examined per sweep. Bounds one pass, not the backlog.
RETENTION_SWEEP_BATCH=500
# SSE event log. Only has to outlive a disconnected client - jobs and
# credit_transactions are the durable audit record, not this.
EVENT_LOG_RETENTION_DAYS=7

# Observability.
# Bearer token for /metrics and /health/workers. Those endpoints describe
# internal topology - instance count, deployed model versions, spare capacity,
# queue backlog - so they are exposed only to the monitoring network in a real
# deployment. Left empty they are unauthenticated and the API says so at startup.
METRICS_TOKEN=
# text for a human reading the console, json for a log shipper.
LOG_FORMAT=text
# Ceiling on a single readiness probe. Bounds the answer, not the query.
HEALTH_CHECK_TIMEOUT_MS=2000
# Keep serving after SIGTERM before closing the listener. Zero suits local
# development; in an orchestrator set it above the load balancer's health-check
# interval, or a routine deploy drops requests that were already accepted.
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=15000

# Worker probe port: /health, /health/ready, /metrics. 0 disables the listener.
# Give each worker on a shared host its own port.
WORKER_HEALTH_PORT=9101
# How often a worker reports itself to the API.
WORKER_HEARTBEAT_SECONDS=15
# When the API stops counting a worker as online. Set independently of the
# interval above, because the API cannot know how a given worker was configured.
WORKER_STALE_AFTER_SECONDS=45
# When a silent worker's record is deleted, so a scaled-down machine stops
# holding an alert open forever.
WORKER_FORGET_AFTER_HOURS=24

# S3 Configuration
S3_BUCKET_NAME=medical-image-masks-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-key-id
AWS_SECRET_ACCESS_KEY=mock-secret-key
# Optional: Set to http://localhost:4566 if using LocalStack or MinIO locally
AWS_S3_ENDPOINT=
