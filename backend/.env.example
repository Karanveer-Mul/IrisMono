PORT=3000
# Three connection identities - see src/db/index.ts and migration 0002.
# Runtime identity: Row-Level Security enforced. Must NOT be a superuser,
# because superusers bypass RLS unconditionally.
DATABASE_URL=postgresql://irismono_app:irismono_app_password@localhost:5432/irismono
# Pre-tenant and system operations (login, registration, invite redemption,
# worker job reports). Has BYPASSRLS.
AUTH_DATABASE_URL=postgresql://irismono_auth:irismono_auth_password@localhost:5432/irismono
# DDL and migrations only.
ADMIN_DATABASE_URL=postgresql://postgres:password@localhost:5432/irismono
JWT_SECRET=super-secret-medical-saas-key-change-in-production
AMQP_URL=amqp://guest:guest@localhost:5672

# Shared secret the GPU worker presents when reporting job outcomes to the API.
WORKER_SECRET=local-dev-worker-secret
# Where the worker reaches the API to report outcomes.
API_BASE_URL=http://localhost:3000
# Which tier queues this worker serves (comma separated). Start a second worker
# with WORKER_QUEUES=queue-vip-jobs to give enterprise tenants dedicated GPUs.
WORKER_QUEUES=queue-standard-jobs
# Stamped onto every job this worker completes. In a real deployment this is the
# image tag or model artifact digest, injected at deploy time - a mask whose
# model version is unknown cannot be recalled if that model is withdrawn.
MODEL_VERSION=irismono-seg-sim-0.1.0
# Defaults to hostname:pid if unset.
# WORKER_ID=
# In-process report retries before a message is dead-lettered.
WORKER_REPORT_ATTEMPTS=3
WORKER_REPORT_RETRY_DELAY_MS=2000

# Reaper: reclaims credits from jobs that will never finish.
JOB_PENDING_TIMEOUT_MINUTES=30
JOB_PROCESSING_TIMEOUT_MINUTES=15
REAPER_INTERVAL_SECONDS=60

# Storage retention. Deletes stored images after this many days; job metadata is
# kept indefinitely for billing and audit. Set to 0 to disable.
# On real S3, configure a bucket lifecycle rule instead - see src/retention.ts.
STORAGE_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_HOURS=6

# S3 Configuration
S3_BUCKET_NAME=medical-image-masks-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-key-id
AWS_SECRET_ACCESS_KEY=mock-secret-key
# Optional: Set to http://localhost:4566 if using LocalStack or MinIO locally
AWS_S3_ENDPOINT=
